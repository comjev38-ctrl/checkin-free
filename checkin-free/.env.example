# Copie ce fichier en .env.local et remplis avec tes propres clés

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...   # secret, jamais exposé au client

# URL publique du site (utilisée en interne pour déclencher l'envoi d'email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (optionnel — laisse vide pour désactiver l'envoi d'email,
# la page de confirmation avec QR à l'écran reste fonctionnelle)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CheckIn Free <billets@tondomaine.fr>
